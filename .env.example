# Environment Configuration Template
# Copy this file to .env and customize for your environment
# SECURITY: Never commit actual credentials to version control

# Application Environment
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0

# MongoDB Configuration (REQUIRED in production)
# Format: mongodb://[username:password@]host:port[/?authSource=admin]
# Example: mongodb://myuser:mypassword@mongo.example.com:27017/?authSource=admin
MONGO_URI=

# Database Name
DB_NAME=dnd

# Logging
LOG_LEVEL=info

# Server Timeouts (in seconds)
READ_TIMEOUT=15
WRITE_TIMEOUT=15

# Pipeline Configuration
PIPELINE_ERROR_HANDLING=continue
PIPELINE_MAX_PARALLEL_FILES=5
PIPELINE_EVENT_BUS_BUFFER_SIZE=1000
PIPELINE_VALIDATION_ENABLED=true
PIPELINE_TRANSFORMATION_ENABLED=true
PIPELINE_LOG_PROGRESS_EVENTS=true
PIPELINE_LOG_LEVEL=info
