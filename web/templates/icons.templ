package templates

import "github.com/emiliopalmerini/quintaedizione.online/internal/domain/collections"

templ CollectionIcon(name string) {
	switch collections.CollectionName(name) {
		case collections.Classi:
			// Helmet
			<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
				<path d="M12 2C7 2 4 6 4 10v2c0 1 .5 2 1.5 2.5L7 15v2h10v-2l1.5-.5C19.5 14 20 13 20 12v-2c0-4-3-8-8-8z"/>
				<path d="M4 12h16"/>
				<path d="M9 2v4"/>
				<path d="M15 2v4"/>
			</svg>
		case collections.Backgrounds:
			// Scroll
			<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
				<path d="M8 21h12a2 2 0 0 0 2-2v-2H10v2a2 2 0 1 1-4 0V5a2 2 0 1 0-4 0v3h4"/>
				<path d="M19 17V5a2 2 0 0 0-2-2H4"/>
			</svg>
		case collections.Incantesimi:
			// Sparkle
			<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
				<path d="M12 2l2.4 7.2L22 12l-7.6 2.8L12 22l-2.4-7.2L2 12l7.6-2.8z"/>
			</svg>
		case collections.Talenti:
			// Diamond
			<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
				<path d="M6 3h12l4 6-10 13L2 9z"/>
				<path d="M2 9h20"/>
				<path d="M10 3l-4 6 6 13 6-13-4-6"/>
			</svg>
		case collections.Equipaggiamenti:
			// Backpack
			<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
				<path d="M5 10v10a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V10"/>
				<path d="M9 6V4a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v2"/>
				<path d="M3 10h18a1 1 0 0 1 0 2H3a1 1 0 0 1 0-2z"/>
			</svg>
		case collections.Servizi:
			// Coins
			<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
				<circle cx="9" cy="9" r="7"/>
				<path d="M15.4 8.6a7 7 0 1 1-5.8 11.8"/>
				<path d="M9 6v6l3 3"/>
			</svg>
		case collections.Regole:
			// Open book
			<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
				<path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/>
				<path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>
			</svg>
		case collections.OggettiMagici:
			// Wand with sparkle
			<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
				<path d="M15 4l-1.5 1.5L20 12l1.5-1.5z"/>
				<path d="M3 21l10-10"/>
				<path d="M9 2l.5 2 .5-2"/>
				<path d="M5 6l2 .5-2 .5"/>
				<path d="M15 2l.5 2 .5-2"/>
			</svg>
		case collections.Mostri:
			// Dragon head
			<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
				<path d="M7 21l-2-4 4-2-3-4 5 1 1-5 3 4 5-3-1 5 4 3-4 2 1 3z"/>
				<circle cx="10" cy="13" r="1" fill="currentColor"/>
			</svg>
		case collections.Glossario:
			// Book with A
			<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
				<path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/>
				<path d="M4 4.5A2.5 2.5 0 0 1 6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15z"/>
				<path d="M12 7l-3 9"/>
				<path d="M12 7l3 9"/>
				<path d="M10 13h4"/>
			</svg>
		case collections.Specie:
			// People
			<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
				<circle cx="9" cy="7" r="3"/>
				<path d="M3 21v-2a4 4 0 0 1 4-4h4a4 4 0 0 1 4 4v2"/>
				<circle cx="17" cy="9" r="2.5"/>
				<path d="M21 21v-1.5a3 3 0 0 0-3-3h-1"/>
			</svg>
		default:
			// Fallback: folder
			<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
				<path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/>
			</svg>
	}
}
