package templates

import "github.com/emiliopalmerini/quintaedizione.online/internal/srd/domain/collections"

// CollectionIcon renders an inline SVG icon for the given collection.
// Icons are from Tabler Icons (MIT), stroke-width 2, using currentColor for dark mode.
templ CollectionIcon(name string) {
	switch collections.CollectionName(name) {
		case collections.Classi:
			// Crossed swords (class identity)
			<svg class="collection-icon-svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<path d="M21 3v5l-11 9l-4 4l-3 -3l4 -4l9 -11l5 0"></path>
				<path d="M5 13l6 6"></path>
				<path d="M14.32 17.32l3.68 3.68l3 -3l-3.365 -3.365"></path>
				<path d="M10 5.5l-2 -2.5h-5v5l3 2.5"></path>
			</svg>
		case collections.Specie:
			// Group of people (species/races)
			<svg class="collection-icon-svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<path d="M10 13a2 2 0 1 0 4 0a2 2 0 0 0 -4 0"></path>
				<path d="M8 21v-1a2 2 0 0 1 2 -2h4a2 2 0 0 1 2 2v1"></path>
				<path d="M15 5a2 2 0 1 0 4 0a2 2 0 0 0 -4 0"></path>
				<path d="M17 10h2a2 2 0 0 1 2 2v1"></path>
				<path d="M5 5a2 2 0 1 0 4 0a2 2 0 0 0 -4 0"></path>
				<path d="M3 13v-1a2 2 0 0 1 2 -2h2"></path>
			</svg>
		case collections.Backgrounds:
			// Scroll/parchment (character backstory)
			<svg class="collection-icon-svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<path d="M17 20h-11a3 3 0 0 1 0 -6h11a3 3 0 0 0 0 6h1a3 3 0 0 0 3 -3v-11a2 2 0 0 0 -2 -2h-10a2 2 0 0 0 -2 2v8"></path>
			</svg>
		case collections.Talenti:
			// Star (talent/feat)
			<svg class="collection-icon-svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<path d="M12 17.75l-6.172 3.245l1.179 -6.873l-5 -4.867l6.9 -1l3.086 -6.253l3.086 6.253l6.9 1l-5 4.867l1.179 6.873l-6.158 -3.245"></path>
			</svg>
		case collections.Incantesimi:
			// Magic wand with sparkles
			<svg class="collection-icon-svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<path d="M6 21l15 -15l-3 -3l-15 15l3 3"></path>
				<path d="M15 6l3 3"></path>
				<path d="M9 3a2 2 0 0 0 2 2a2 2 0 0 0 -2 2a2 2 0 0 0 -2 -2a2 2 0 0 0 2 -2"></path>
				<path d="M19 13a2 2 0 0 0 2 2a2 2 0 0 0 -2 2a2 2 0 0 0 -2 -2a2 2 0 0 0 2 -2"></path>
			</svg>
		case collections.Mostri:
			// Skull (bestiary/monsters)
			<svg class="collection-icon-svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<path d="M12 4c4.418 0 8 3.358 8 7.5c0 1.901 -.755 3.637 -2 4.96l0 2.54a1 1 0 0 1 -1 1h-10a1 1 0 0 1 -1 -1v-2.54c-1.245 -1.322 -2 -3.058 -2 -4.96c0 -4.142 3.582 -7.5 8 -7.5"></path>
				<path d="M10 17v3"></path>
				<path d="M14 17v3"></path>
				<path d="M8 11a1 1 0 1 0 2 0a1 1 0 1 0 -2 0"></path>
				<path d="M14 11a1 1 0 1 0 2 0a1 1 0 1 0 -2 0"></path>
			</svg>
		case collections.OggettiMagici:
			// Diamond/gem (magic item)
			<svg class="collection-icon-svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<path d="M6 5h12l3 5l-8.5 9.5a.7 .7 0 0 1 -1 0l-8.5 -9.5l3 -5"></path>
				<path d="M10 12l-2 -2.2l.6 -1"></path>
			</svg>
		case collections.Equipaggiamenti:
			// Backpack (equipment/gear)
			<svg class="collection-icon-svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<path d="M5 18v-6a6 6 0 0 1 6 -6h2a6 6 0 0 1 6 6v6a3 3 0 0 1 -3 3h-8a3 3 0 0 1 -3 -3"></path>
				<path d="M10 6v-1a2 2 0 1 1 4 0v1"></path>
				<path d="M9 21v-4a2 2 0 0 1 2 -2h2a2 2 0 0 1 2 2v4"></path>
				<path d="M11 10h2"></path>
			</svg>
		case collections.Servizi:
			// Stacked coins (commerce/services)
			<svg class="collection-icon-svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<path d="M9 14c0 1.657 2.686 3 6 3s6 -1.343 6 -3s-2.686 -3 -6 -3s-6 1.343 -6 3"></path>
				<path d="M9 14v4c0 1.656 2.686 3 6 3s6 -1.344 6 -3v-4"></path>
				<path d="M3 6c0 1.072 1.144 2.062 3 2.598s4.144 .536 6 0c1.856 -.536 3 -1.526 3 -2.598c0 -1.072 -1.144 -2.062 -3 -2.598s-4.144 -.536 -6 0c-1.856 .536 -3 1.526 -3 2.598"></path>
				<path d="M3 6v10c0 .888 .772 1.45 2 2"></path>
				<path d="M3 11c0 .888 .772 1.45 2 2"></path>
			</svg>
		case collections.Regole:
			// Open book (rules)
			<svg class="collection-icon-svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<path d="M3 19a9 9 0 0 1 9 0a9 9 0 0 1 9 0"></path>
				<path d="M3 6a9 9 0 0 1 9 0a9 9 0 0 1 9 0"></path>
				<path d="M3 6l0 13"></path>
				<path d="M12 6l0 13"></path>
				<path d="M21 6l0 13"></path>
			</svg>
		case collections.Glossario:
			// Vocabulary/dictionary (glossary)
			<svg class="collection-icon-svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<path d="M10 19h-6a1 1 0 0 1 -1 -1v-14a1 1 0 0 1 1 -1h6a2 2 0 0 1 2 2a2 2 0 0 1 2 -2h6a1 1 0 0 1 1 1v14a1 1 0 0 1 -1 1h-6a2 2 0 0 0 -2 2a2 2 0 0 0 -2 -2"></path>
				<path d="M12 5v16"></path>
				<path d="M7 7h1"></path>
				<path d="M7 11h1"></path>
				<path d="M16 7h1"></path>
				<path d="M16 11h1"></path>
				<path d="M16 15h1"></path>
			</svg>
		default:
			// Generic document (fallback)
			<svg class="collection-icon-svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<path d="M14 3v4a1 1 0 0 0 1 1h4"></path>
				<path d="M17 21h-10a2 2 0 0 1 -2 -2v-14a2 2 0 0 1 2 -2h7l5 5v11a2 2 0 0 1 -2 2"></path>
				<path d="M9 9l1 0"></path>
				<path d="M9 13l6 0"></path>
				<path d="M9 17l6 0"></path>
			</svg>
	}
}

// CompassIcon renders a compass SVG (Tabler Icons, MIT).
templ CompassIcon() {
	<svg class="collection-icon-svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		<path d="M12 12m-9 0a9 9 0 1 0 18 0a9 9 0 1 0 -18 0"></path>
		<path d="M15.5 8.5l-2.56 6.44l-6.44 2.56l2.56 -6.44l6.44 -2.56"></path>
		<path d="M12 12m-1 0a1 1 0 1 0 2 0a1 1 0 1 0 -2 0"></path>
	</svg>
}

// MapIcon renders a map/treasure-map SVG (Tabler Icons, MIT).
templ MapIcon() {
	<svg class="collection-icon-svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		<path d="M3 7l6 -3l6 3l6 -3v13l-6 3l-6 -3l-6 3v-13"></path>
		<path d="M9 4v13"></path>
		<path d="M15 7v13"></path>
	</svg>
}

// D20Icon renders a d20 die SVG (Tabler Icons, MIT).
templ D20Icon() {
	<svg class="collection-icon-svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		<path d="M12 2l8.5 5v10l-8.5 5l-8.5 -5v-10z"></path>
		<path d="M12 2v5.5"></path>
		<path d="M20.5 7l-4.5 2"></path>
		<path d="M3.5 7l4.5 2"></path>
		<path d="M12 7.5l4.5 2v5l-4.5 2.5l-4.5 -2.5v-5z"></path>
		<path d="M12 17v5"></path>
	</svg>
}
