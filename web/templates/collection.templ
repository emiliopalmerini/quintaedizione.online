package templates

import (
	"slices"
	"strconv"
	"strings"

	"github.com/emiliopalmerini/quintaedizione.online/internal/adapters/web/models"
)

templ CollectionPage(data models.CollectionPageData) {
	@BaseLayout(data.PageData) {
		<!-- Top loading bar -->
		<div class="loading-bar"></div>

		<section class="search-sticky bg-white border p-2 mb-3">
			<form id="search-form"
				hx-get={ "/" + data.PageData.Collection + "/rows" }
				hx-target="#rows"
				hx-trigger="submit, keyup delay:100ms from:#q, change from:select, change from:input[type=hidden], change from:input[type=checkbox], change from:input[type=number]"
				hx-push-url="true"
				hx-indicator=".loading-bar"
				class="flex flex-col gap-2">
				<div class="flex items-center gap-2 flex-wrap">
					<input id="q" name="q" placeholder="Cerca…" value={ data.Query } class="field flex-1" minlength="2"/>

					<!-- Collection-specific filters -->
					@collectionFilters(data.Filters, data.PageSize)

					<button class="btn" type="submit">
						<span class="htmx-indicator">
							<span class="spinner"></span>
						</span>
						<span>Cerca</span>
					</button>
				</div>

				<!-- Loading indicator with enhanced animation -->
				<div class="htmx-indicator flex items-center gap-2 text-sm text-secondary hidden">
					<span class="spinner"></span>
					<span>Caricamento in corso...</span>
				</div>
			</form>
		</section>

		<section class="bg-white border">
			<div id="rows">
				@RowsPartial(data)
			</div>
		</section>
	}
}

func hasActiveFilters(filters []models.FilterOption) bool {
	for _, f := range filters {
		if f.CurrentValue != "" {
			return true
		}
	}
	return false
}

func filterButtonText(f models.FilterOption) string {
	if len(f.CurrentValues) == 0 {
		return f.Label
	}
	if len(f.CurrentValues) == 1 {
		return f.CurrentValues[0]
	}
	return strconv.Itoa(len(f.CurrentValues)) + " selezionati"
}

func isValueSelected(f models.FilterOption, value string) bool {
	return slices.Contains(f.CurrentValues, value)
}

templ collectionFilters(filters []models.FilterOption, pageSize int) {
	for _, f := range filters {
		<div class="filter-multiselect" data-filter-name={ f.Name }>
			<input type="hidden" name={ f.Name } value={ strings.Join(f.CurrentValues, ",") }/>
			<button type="button" class={ "field w-auto filter-multiselect-btn", templ.KV("filter-multiselect-active", len(f.CurrentValues) > 0) }>
				{ filterButtonText(f) }
				<span class="filter-multiselect-arrow">▾</span>
			</button>
			<div class="filter-multiselect-dropdown">
				for _, v := range f.Values {
					<label class={ "filter-option-checkbox", templ.KV("filter-option-disabled", v.Count == 0 && !isValueSelected(f, v.Value)) }>
						if isValueSelected(f, v.Value) {
							<input type="checkbox" value={ v.Value } checked/>
						} else {
							<input type="checkbox" value={ v.Value } disabled?={ v.Count == 0 }/>
						}
						<span class="filter-option-label">{ v.Value }</span>
						if v.Count > 0 || isValueSelected(f, v.Value) {
							<span class="filter-option-count">{ strconv.FormatInt(v.Count, 10) }</span>
						} else {
							<span class="filter-option-count">0</span>
						}
					</label>
				}
			</div>
		</div>
	}
	// Page size selector (always shown)
	<select name="page_size" class="field w-28">
		<option value="10" if pageSize == 10 { selected }>10/pagina</option>
		<option value="20" if pageSize == 20 { selected }>20/pagina</option>
		<option value="50" if pageSize == 50 { selected }>50/pagina</option>
		<option value="100" if pageSize == 100 { selected }>100/pagina</option>
	</select>
}
