package templates

import "github.com/emiliopalmerini/quintaedizione.online/internal/adapters/web/models"
import "strconv"

templ ItemPage(data models.ItemPageData) {
	@BaseLayout(data.PageData) {
		<!-- Header Navigation -->
		<div class="item-header sticky top-under-header">
			<a href={ templ.URL("/srd/" + data.PageData.Collection) } class="btn item-back-btn">
				<span class="item-back-icon">
					@CollectionIcon(data.PageData.Collection)
				</span>
				<span class="item-back-label">{ data.CollectionLabel }</span>
			</a>

			<div class="item-nav">
				if data.PrevID != "" {
					<a class="btn btn-icon"
						href={ templ.URL("/srd/" + data.PageData.Collection + "/" + data.PrevID) }
						hx-get={ "/srd/" + data.PageData.Collection + "/" + data.PrevID }
						hx-target="#page-root"
						hx-select="#page-root"
						hx-swap="outerHTML"
						hx-push-url="true"
						hx-indicator="#page-loading"
						aria-label="Precedente">
						<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
							<polyline points="15 18 9 12 15 6"></polyline>
						</svg>
					</a>
				} else {
					<span class="btn btn-icon btn-disabled" aria-disabled="true">
						<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
							<polyline points="15 18 9 12 15 6"></polyline>
						</svg>
					</span>
				}

				if data.Total > 0 {
					<span class="item-nav-position">{ strconv.Itoa(data.Position) } di { strconv.Itoa(data.Total) }</span>
				}

				if data.NextID != "" {
					<a class="btn btn-icon"
						href={ templ.URL("/srd/" + data.PageData.Collection + "/" + data.NextID) }
						hx-get={ "/srd/" + data.PageData.Collection + "/" + data.NextID }
						hx-target="#page-root"
						hx-select="#page-root"
						hx-swap="outerHTML"
						hx-push-url="true"
						hx-indicator="#page-loading"
						aria-label="Successivo">
						<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
							<polyline points="9 6 15 12 9 18"></polyline>
						</svg>
					</a>
				} else {
					<span class="btn btn-icon btn-disabled" aria-disabled="true">
						<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
							<polyline points="9 6 15 12 9 18"></polyline>
						</svg>
					</span>
				}
			</div>
		</div>

		<!-- Item title -->
		if data.PageData.DocTitle != "" {
			<h1 class="item-title">{ data.PageData.DocTitle }</h1>
		}

		<!-- Item content -->
		<article class="item-content" data-markdown>
			if data.BodyHTML != "" {
				<div data-raw={ getMarkdownWithTitle(data.PageData.DocTitle, data.BodyRaw) }>
					@templ.Raw(data.BodyHTML)
				</div>
			} else {
				<div class="empty-state">Nessuna descrizione disponibile.</div>
			}
		</article>

		<!-- Action buttons -->
		<div class="item-footer">
			<button id="copy-markdown-btn" class="btn btn-primary">
				📋 Copia
			</button>
		</div>
	}
}

// Helper function to prepend title to markdown content for copy functionality
func getMarkdownWithTitle(title, body string) string {
	if title == "" {
		return body
	}
	return "## " + title + "\n\n" + body
}
