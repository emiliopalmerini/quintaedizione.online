package templates

import "github.com/emiliopalmerini/quintaedizione.online/internal/adapters/web/models"
import "strconv"
import "fmt"

templ SearchPage(data models.SearchPageData) {
	@BaseLayout(data.PageData) {
		<section class="search-page-header">
			<a href="/" class="search-page-back">&larr; Torna alla home</a>
			<h1 class="search-page-title">Risultati della ricerca</h1>
			<p class="search-page-query">
				Hai cercato: <strong>{ data.Query }</strong>
			</p>
			if data.Total > 0 {
				<p class="search-page-count">
					Trovati <strong>{ strconv.FormatInt(data.Total, 10) }</strong> risultati totali
				</p>
			}
		</section>

		if len(data.Results) == 0 {
			<section class="search-page-empty">
				<p class="search-page-empty-title">Nessun risultato trovato</p>
				<p class="search-page-empty-hint">Prova con altri termini di ricerca</p>
			</section>
		} else {
			for _, result := range data.Results {
				<section class="search-page-section">
					<div class="search-page-section-header">
						<h2 class="search-page-section-title">{ result.CollectionLabel }</h2>
						<div class="search-page-section-meta">
							<span class="search-page-section-count">
								{ strconv.FormatInt(result.Total, 10) } risultati
							</span>
							if result.HasMore {
								<a
									href={ templ.URL(fmt.Sprintf("/%s?q=%s", result.CollectionName, data.Query)) }
									class="search-page-section-link"
								>
									Vedi tutti &rarr;
								</a>
							}
						</div>
					</div>

					<div class="search-page-results">
						for _, doc := range result.Documents {
							<a
								href={ templ.URL(fmt.Sprintf("/%s/%s", result.CollectionName, doc.ID)) }
								class="search-page-result"
							>
								<div class="search-page-result-content">
									<h3 class="search-page-result-title">
										@templ.Raw(HighlightQuery(doc.Title, data.Query))
									</h3>
									if len(doc.DisplayElements) > 0 {
										<div class="search-page-result-badges">
											for _, elem := range doc.DisplayElements {
												if elem.Value != "" {
													<span class="search-page-result-badge">{ elem.Value }</span>
												}
											}
										</div>
									}
								</div>
								<span class="search-page-result-arrow">&rarr;</span>
							</a>
						}
					</div>
				</section>
			}
		}
	}
}
