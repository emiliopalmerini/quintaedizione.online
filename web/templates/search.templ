package templates

import "github.com/emiliopalmerini/quintaedizione.online/internal/adapters/web/models"
import "strconv"
import "fmt"

templ SearchPage(data models.SearchPageData) {
	@BaseLayout(data.PageData) {
		<section class="search-page-header">
			<a href="/srd" class="search-page-back">&larr; Torna alla home</a>
			<form class="search-page-form" action="/srd/search" method="get">
				<div class="search-input-group">
					<svg class="search-icon" width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
						<path d="M9 17C13.4183 17 17 13.4183 17 9C17 4.58172 13.4183 1 9 1C4.58172 1 1 4.58172 1 9C1 13.4183 4.58172 17 9 17Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
						<path d="M19 19L14.65 14.65" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
					</svg>
					<input
						type="text"
						name="q"
						value={ data.Query }
						placeholder="Cerca in tutte le collezioni..."
						class="field flex-1"
						autocomplete="off"
						aria-label="Cerca contenuti"
						autofocus
					/>
				</div>
			</form>
			if data.Total > 0 {
				<p class="search-page-count">
					Trovati <strong>{ strconv.FormatInt(data.Total, 10) }</strong> risultati totali
				</p>
			}
		</section>

		if len(data.Results) == 0 {
			<section class="search-page-empty">
				<svg class="search-empty-icon" width="48" height="48" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
					<circle cx="11" cy="11" r="8" stroke="currentColor" stroke-width="2"/>
					<path d="M21 21L16.65 16.65" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
				</svg>
				<p class="search-page-empty-title">Nessun risultato per "<strong>{ data.Query }</strong>"</p>
				<div class="search-empty-suggestions">
					<p class="search-empty-suggestions-label">Suggerimenti:</p>
					<ul class="search-empty-tips">
						<li>Controlla l'ortografia</li>
						<li>Prova con meno parole chiave</li>
						<li>Cerca in italiano (es. "Palla di Fuoco" non "Fireball")</li>
					</ul>
				</div>
				if len(data.Collections) > 0 {
					<div class="search-empty-collections">
						<p class="search-empty-collections-label">Collezioni popolari:</p>
						<div class="search-empty-collection-chips">
							for _, col := range data.Collections {
								<a href={ templ.URL("/srd/" + col.Name) } class="search-empty-chip">{ col.Label }</a>
							}
						</div>
					</div>
				}
			</section>
		} else {
			for _, result := range data.Results {
				<section class="search-page-section">
					<div class="search-page-section-header">
						<h2 class="search-page-section-title">{ result.CollectionLabel }</h2>
						<div class="search-page-section-meta">
							<span class="search-page-section-count">
								{ strconv.FormatInt(result.Total, 10) } risultati
							</span>
							if result.HasMore {
								<a
									href={ templ.URL(fmt.Sprintf("/srd/%s?q=%s", result.CollectionName, data.Query)) }
									class="search-page-section-link"
								>
									Vedi tutti &rarr;
								</a>
							}
						</div>
					</div>

					<div class="search-page-results">
						for _, doc := range result.Documents {
							<a
								href={ templ.URL(fmt.Sprintf("/srd/%s/%s", result.CollectionName, doc.ID)) }
								class="search-page-result"
							>
								<div class="search-page-result-content">
									<h3 class="search-page-result-title">
										@templ.Raw(HighlightQuery(doc.Title, data.Query))
									</h3>
									if len(doc.DisplayElements) > 0 {
										<div class="search-page-result-badges">
											for _, elem := range doc.DisplayElements {
												if elem.Value != "" {
													<span class="search-page-result-badge">{ elem.Value }</span>
												}
											}
										</div>
									}
									if doc.Snippet != "" {
										<p class="search-page-result-snippet">
											@templ.Raw(HighlightQuery(doc.Snippet, data.Query))
										</p>
									}
								</div>
								<span class="search-page-result-arrow">&rarr;</span>
							</a>
						}
					</div>
				</section>
			}
		}
	}
}
