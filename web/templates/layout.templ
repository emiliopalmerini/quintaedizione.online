package templates

import pkgweb "github.com/emiliopalmerini/quintaedizione.online/pkg/web"

// SiteLayout is the unified shell for all pages.
// activeNav identifies the current top-level task or compendium section.
// extraHeadHTML: additional <head> content (e.g. extra scripts).
templ SiteLayout(title, description, activeNav string, extraHeadHTML templ.Component) {
	<!DOCTYPE html>
	<html lang="it">
	<head>
		<meta charset="utf-8"/>
		<title>
			if title != "" {
				{ title } — quintaedizione.online
			} else {
				quintaedizione.online
			}
		</title>
		<meta name="viewport" content="width=device-width, initial-scale=1"/>
		if description != "" {
			<meta name="description" content={ description }/>
			<meta property="og:description" content={ description }/>
		}
		if title != "" {
			<meta property="og:title" content={ title }/>
		}
		<meta property="og:image" content="https://quintaedizione.online/static/img/dyson-map-2.webp"/>
		<meta property="og:type" content="website"/>
		<meta property="og:site_name" content="quintaedizione.online"/>
		<script>
			(function(){var d=document.documentElement,c=document.cookie.match(/(?:^|;\s*)theme=(dark|light)/),t=c?c[1]:null;if(!t)try{t=localStorage.getItem('theme')}catch(e){}if(!t&&window.matchMedia&&window.matchMedia('(prefers-color-scheme:dark)').matches)t='dark';if(t==='dark')d.classList.add('dark');else d.classList.remove('dark')})()
		</script>
		<script src={ pkgweb.ScriptAssetPath("htmx.min.js") } defer></script>
		@templ.Raw("<style type=\"text/css\">" + pkgweb.CriticalCSS() + "</style>")
		<link rel="preload" as="style" href={ pkgweb.CSSBundlePath() }/>
		<link rel="stylesheet" href={ pkgweb.CSSBundlePath() }/>
		<noscript><style>@media (max-width:640px){.site-nav-links{position:static;max-height:none;opacity:1;pointer-events:auto;box-shadow:none;padding:0}.nav-hamburger{display:none}.site-nav-container{flex-wrap:wrap}}</style></noscript>
		<link rel="preconnect" href="https://fonts.googleapis.com"/>
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous"/>
		<link
			id="font-css"
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
			media="print"
		/>
		<noscript>
			<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"/>
		</noscript>
		<link rel="icon" href="/static/favicon.svg" type="image/svg+xml"/>
		<script src={ pkgweb.ScriptAssetPath("main.js") } defer></script>
		if extraHeadHTML != nil {
			@extraHeadHTML
		}
	</head>
	<body class="flex flex-col min-h-screen">
		<a href="#page-root" class="skip-to-content">Vai al contenuto principale</a>

		<header class="site-nav">
			<div class="site-nav-container">
				<a href="/" class="site-nav-brand">quintaedizione.online</a>
				<nav class="site-nav-links" id="nav-menu" aria-label="Navigazione principale">
					if activeNav == "giocare" {
						<a href="/giocare" class="site-nav-link active" aria-current="page">Giocare</a>
					} else {
						<a href="/giocare" class="site-nav-link">Giocare</a>
					}
					if activeNav == "preparare" {
						<a href="/preparare" class="site-nav-link active" aria-current="page">Preparare</a>
					} else {
						<a href="/preparare" class={ "site-nav-link", templ.KV("active", activeNav == "combattimenti" || activeNav == "mappe" || activeNav == "generatori") }>Preparare</a>
					}
					if activeNav == "srd" {
						<a href="/srd" class="site-nav-link active" aria-current="page">Compendio</a>
					} else {
						<a href="/srd" class="site-nav-link">Compendio</a>
					}
				</nav>
				<div class="theme-switcher" id="theme-switcher" role="radiogroup" aria-label="Tema">
					<label class="theme-switcher-option">
					<input type="radio" name="theme" value="light" checked/>
						<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"></circle><line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line><line x1="1" y1="12" x2="3" y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line></svg>
					</label>
					<label class="theme-switcher-option">
					<input type="radio" name="theme" value="dark"/>
						<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>
					</label>
				</div>
				<button class="nav-hamburger" id="nav-hamburger" aria-label="Apri menu" aria-expanded="false" aria-controls="nav-menu">
					<span class="nav-hamburger-line"></span>
					<span class="nav-hamburger-line"></span>
					<span class="nav-hamburger-line"></span>
				</button>
			</div>
		</header>

		@sitePatreonBanner()

		<main class="flex-1">
			<div id="page-root" class="container mx-auto max-w-4xl py-8">
				{ children... }
				<div id="page-loading" class="page-overlay" aria-hidden="true">
					<div class="page-overlay-inner">
						<span class="spinner"></span>
					</div>
				</div>
			</div>
		</main>

		@siteFooter()
	</body>
	</html>
}

templ sitePatreonBanner() {
	<div id="patreon-banner" class="patreon-banner">
		Questo progetto è gratuito grazie ai nostri supporter.
		<a href="https://patreon.com/DueDraghiPlus" target="_blank" rel="noopener noreferrer">Unisciti a loro su Patreon!</a>
		<button type="button" class="patreon-banner-dismiss" aria-label="Chiudi">&times;</button>
	</div>
}

templ siteFooter() {
	<footer class="mt-auto border-t py-6">
		<div class="container mx-auto max-w-4xl text-center">
			<p class="text-xs text-secondary m-0" style="line-height: 1.6;">
				<span class="patreon-footer">
					<a href="https://patreon.com/DueDraghiPlus" target="_blank" rel="noopener noreferrer">Supporta il progetto su Patreon</a>
				</span>
				 |
				Creato da <a href="https://duedraghialmicrofono.com" target="_blank" rel="noopener noreferrer">Due Draghi al Microfono</a>
				 |
				Questo progetto include materiale dall'<a href="https://www.dndbeyond.com/srd" target="_blank" rel="noopener noreferrer">SRD 5.2.1</a> rilasciato sotto licenza <a href="https://creativecommons.org/licenses/by/4.0/legalcode" target="_blank" rel="noopener noreferrer">CC BY 4.0</a>.
				Questo progetto include materiale dal <a href="https://dnd.wizards.com/resources/systems-reference-document" target="_blank" rel="noopener noreferrer">System Reference Document 5.1</a> di Wizards of the Coast LLC, rilasciato sotto licenza <a href="https://creativecommons.org/licenses/by/4.0/legalcode" target="_blank" rel="noopener noreferrer">CC BY 4.0</a>.
				Cartografia di <a href="https://dysonlogos.blog" target="_blank" rel="noopener noreferrer">Dyson Logos</a>.
				Questo progetto include materiale tratto dal <a href="https://slyflourish.com/lazy_gm_resource_document.html" target="_blank" rel="noopener noreferrer">Lazy GM's Resource Document</a> di Michael E. Shea di <a href="https://slyflourish.com" target="_blank" rel="noopener noreferrer">SlyFlourish.com</a>, disponibile sotto licenza <a href="https://creativecommons.org/licenses/by/4.0/legalcode" target="_blank" rel="noopener noreferrer">Creative Commons Attribution 4.0 International</a>.
			</p>
		</div>
	</footer>
}

// EncountersScript is a helper component to load encounters.js.
templ EncountersScript() {
	<script src={ pkgweb.ScriptAssetPath("js/encounters.js") } defer></script>
}
