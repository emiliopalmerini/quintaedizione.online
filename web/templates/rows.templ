package templates

import "github.com/emiliopalmerini/quintaedizione.online/internal/adapters/web/models"
import "strconv"

templ RowsPartial(data models.CollectionPageData) {
	if hasActiveFilters(data.Filters) {
		<div class="filter-chips-bar">
			for _, f := range data.Filters {
				for _, val := range f.CurrentValues {
					<button type="button" class="filter-chip" data-filter-name={ f.Name } data-filter-value={ val }>
						<span class="filter-chip-label">{ f.Label }:</span>
						<span class="filter-chip-value">{ val }</span>
						<span class="filter-chip-remove" aria-label="Rimuovi filtro">&times;</span>
					</button>
				}
			}
			<button type="button" class="clear-all-btn" id="clear-all-filters">Azzera filtri</button>
		</div>
	}

	<div class="divide-y">
		for _, doc := range data.Documents {
			@documentRow(doc, data.PageData.Collection)
		}

		if len(data.Documents) == 0 {
			@emptyState(data.Query, hasActiveFilters(data.Filters))
		}
	</div>

	if data.Total > int64(data.PageSize) {
		@pagination(data)
	}
}

templ documentRow(doc models.Document, collection string) {
	<a href={ templ.URL("/" + collection + "/" + getDocSlug(doc)) }
		class="result-item"
		hx-get={ "/" + collection + "/" + getDocSlug(doc) }
		hx-target="#page-root"
		hx-select="#page-root"
		hx-swap="outerHTML"
		hx-push-url="true"
		hx-indicator="#page-loading">
		<div class="result-item-header">
			<h3 class="result-item-title">{ getDocName(doc) }</h3>
			if doc.Translated {
				<span class="result-badge result-badge-translated">Tradotto</span>
			}
		</div>
		if len(doc.DisplayElements) > 0 {
			<div class="result-item-meta">
				for _, element := range doc.DisplayElements {
					<span class="result-badge">{ element.Value }</span>
				}
			</div>
		}
	</a>
}

templ pagination(data models.CollectionPageData) {
	<div class="item-nav border-t bg-neutral-50 px-2 sm:px-4 py-3">
		if data.HasPrev {
			@prevButton(data)
		} else {
			<span class="btn btn-icon btn-disabled" aria-disabled="true">
				<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
					<polyline points="15 18 9 12 15 6"></polyline>
				</svg>
			</span>
		}
		<span class="item-nav-position">{ strconv.Itoa(data.Page) } di { strconv.Itoa(data.TotalPages) }</span>
		if data.HasNext {
			@nextButton(data)
		} else {
			<span class="btn btn-icon btn-disabled" aria-disabled="true">
				<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
					<polyline points="9 6 15 12 9 18"></polyline>
				</svg>
			</span>
		}
	</div>
}

templ emptyState(query string, hasFilters bool) {
	<div class="empty-state-container">
		<div class="empty-state-icon">
			<svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
				<circle cx="11" cy="11" r="8"></circle>
				<line x1="21" y1="21" x2="16.65" y2="16.65"></line>
			</svg>
		</div>
		if query != "" {
			<p class="empty-state-title">
				Nessun risultato per <strong>{ query }</strong>
			</p>
		} else {
			<p class="empty-state-title">Nessun documento trovato</p>
		}
		<div class="empty-state-suggestions">
			if hasFilters {
				<p>Prova a rimuovere alcuni filtri per ampliare la ricerca.</p>
				<button type="button" class="btn btn-secondary empty-state-reset" id="clear-all-filters">Azzera filtri</button>
			} else if query != "" {
				<p>Prova con termini diversi o più generici.</p>
			}
		</div>
	</div>
}

// Helper functions for document name and slug
func getDocName(doc models.Document) string {
	if doc.Title != "" {
		return doc.Title
	}
	return doc.ID
}

func getDocSlug(doc models.Document) string {
	return doc.ID
}

func paginationURL(data models.CollectionPageData, page int) string {
	base := "/" + data.PageData.Collection + "/rows?page=" + strconv.Itoa(page)
	if data.PageData.QueryString != "" {
		return base + "&" + data.PageData.QueryString
	}
	return base
}

templ prevButton(data models.CollectionPageData) {
	<button hx-get={ paginationURL(data, data.Page-1) }
			hx-target="#rows"
			class="btn btn-icon"
			aria-label="Precedente">
		<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
			<polyline points="15 18 9 12 15 6"></polyline>
		</svg>
	</button>
}

templ nextButton(data models.CollectionPageData) {
	<button hx-get={ paginationURL(data, data.Page+1) }
			hx-target="#rows"
			class="btn btn-icon"
			aria-label="Successiva">
		<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
			<polyline points="9 6 15 12 9 18"></polyline>
		</svg>
	</button>
}