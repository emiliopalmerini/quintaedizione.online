package templates

import "github.com/emiliopalmerini/quintaedizione.online/internal/srd/web/models"
import "strconv"
import "strings"

templ RowsPartial(data models.CollectionPageData) {
	if data.QuickFilter != nil {
		<div class="quick-filter-bar" data-filter-name={ data.QuickFilter.FilterName }>
			for _, chip := range data.QuickFilter.Chips {
				<button type="button"
					class={ "quick-filter-chip", templ.KV("active", chip.Active) }
					data-values={ strings.Join(chip.Values, ",") }>
					{ chip.Label }
				</button>
			}
		</div>
	}

	if hasActiveFilters(data.Filters) {
		<div class="filter-chips-bar">
			for _, f := range data.Filters {
				for _, val := range f.CurrentValues {
					<button type="button" class="filter-chip" data-filter-name={ f.Name } data-filter-value={ val }>
						<span class="filter-chip-label">{ f.Label }:</span>
						<span class="filter-chip-value">{ val }</span>
						<span class="filter-chip-remove" aria-label="Rimuovi filtro">&times;</span>
					</button>
				}
			}
			<button type="button" class="clear-all-btn" id="clear-all-filters">Azzera filtri</button>
		</div>
	}

	<div class="divide-y">
		for _, doc := range data.Documents {
			@documentRow(doc, data.PageData.Collection)
		}

		if len(data.Documents) == 0 {
			@emptyState(data.Query, hasActiveFilters(data.Filters))
		}
	</div>

	if data.Total > int64(data.PageSize) {
		@pagination(data)
	}
}

templ documentRow(doc models.Document, collection string) {
	<a href={ templ.URL("/srd/" + collection + "/" + getDocSlug(doc)) }
		class="result-item"
		hx-get={ "/srd/" + collection + "/" + getDocSlug(doc) }
		hx-target="#page-root"
		hx-select="#page-root"
		hx-swap="outerHTML"
		hx-push-url="true"
		hx-indicator="#page-loading">
		<div class="result-item-header">
			<h3 class="result-item-title">{ getDocName(doc) }</h3>
			<div class="result-item-header-badges">
				if doc.Translated {
					<span class="result-badge result-badge-translated">Tradotto</span>
				}
				for _, badge := range editionBadges(doc) {
					<span class="result-badge result-badge-edition">{ badge }</span>
				}
			</div>
		</div>
		if hasNonEditionElements(doc.DisplayElements) {
			<div class="result-item-meta">
				for _, element := range doc.DisplayElements {
					if element.Type != "edition" {
						<span class="result-badge">{ element.Value }</span>
					}
				}
			</div>
		}
	</a>
}

templ pagination(data models.CollectionPageData) {
	<div class="pagination border-t">
		<span class="pagination-range">
			{ strconv.Itoa(data.StartItem) }-{ strconv.Itoa(data.EndItem) } di { strconv.FormatInt(data.Total, 10) }
		</span>
		<div class="pagination-controls">
			if data.HasPrev {
				@prevButton(data)
			} else {
				<span class="btn btn-icon btn-disabled" aria-disabled="true">
					<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
						<polyline points="15 18 9 12 15 6"></polyline>
					</svg>
				</span>
			}
			<div class="pagination-pages">
				for _, p := range paginationPages(data.Page, data.TotalPages) {
					if p == -1 {
						<span class="pagination-ellipsis">&hellip;</span>
					} else if p == data.Page {
						<span class="pagination-page active">{ strconv.Itoa(p) }</span>
					} else {
						<button hx-get={ paginationURL(data, p) }
							hx-target="#rows"
							class="pagination-page">
							{ strconv.Itoa(p) }
						</button>
					}
				}
			</div>
			if data.HasNext {
				@nextButton(data)
			} else {
				<span class="btn btn-icon btn-disabled" aria-disabled="true">
					<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
						<polyline points="9 6 15 12 9 18"></polyline>
					</svg>
				</span>
			}
		</div>
	</div>
}

templ emptyState(query string, hasFilters bool) {
	<div class="empty-state-container">
		<div class="empty-state-icon">
			<svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
				<circle cx="11" cy="11" r="8"></circle>
				<line x1="21" y1="21" x2="16.65" y2="16.65"></line>
			</svg>
		</div>
		if query != "" {
			<p class="empty-state-title">
				Nessun risultato per <strong>{ query }</strong>
			</p>
		} else {
			<p class="empty-state-title">Nessun documento trovato</p>
		}
		<div class="empty-state-suggestions">
			if hasFilters {
				<p>Prova a rimuovere alcuni filtri per ampliare la ricerca.</p>
				<button type="button" class="btn btn-secondary empty-state-reset" id="clear-all-filters">Azzera filtri</button>
			} else if query != "" {
				<p>Prova con termini diversi o più generici.</p>
			}
		</div>
	</div>
}

// Helper functions for document name and slug
func getDocName(doc models.Document) string {
	if doc.Title != "" {
		return doc.Title
	}
	return doc.ID
}

func getDocSlug(doc models.Document) string {
	return doc.ID
}

func editionBadges(doc models.Document) []string {
	var badges []string
	for _, e := range doc.DisplayElements {
		if e.Type == "edition" {
			badges = append(badges, e.Value)
		}
	}
	return badges
}

func hasNonEditionElements(elements []models.DocumentDisplayField) bool {
	for _, e := range elements {
		if e.Type != "edition" {
			return true
		}
	}
	return false
}

// paginationPages returns the page numbers to display in the pagination bar.
// Uses -1 as a sentinel for ellipsis. Shows first, last, and 2 pages around current.
func paginationPages(current, total int) []int {
	if total <= 7 {
		pages := make([]int, total)
		for i := range pages {
			pages[i] = i + 1
		}
		return pages
	}

	pages := []int{}
	// Always show first page
	pages = append(pages, 1)

	// Left boundary: 2 before current
	left := current - 2
	right := current + 2

	if left <= 2 {
		// Near start: show pages 2..right, then ellipsis, then last
		for i := 2; i <= right && i < total; i++ {
			pages = append(pages, i)
		}
		if right < total-1 {
			pages = append(pages, -1)
		}
		if right < total {
			pages = append(pages, total)
		}
	} else if right >= total-1 {
		// Near end: show first, ellipsis, then left..total
		pages = append(pages, -1)
		for i := left; i <= total; i++ {
			if i > 1 {
				pages = append(pages, i)
			}
		}
	} else {
		// Middle: first, ellipsis, left..right, ellipsis, last
		pages = append(pages, -1)
		for i := left; i <= right; i++ {
			pages = append(pages, i)
		}
		pages = append(pages, -1)
		pages = append(pages, total)
	}

	return pages
}

func paginationURL(data models.CollectionPageData, page int) string {
	base := "/srd/" + data.PageData.Collection + "/rows?page=" + strconv.Itoa(page)
	if data.PageData.QueryString != "" {
		return base + "&" + data.PageData.QueryString
	}
	return base
}

templ prevButton(data models.CollectionPageData) {
	<button hx-get={ paginationURL(data, data.Page-1) }
			hx-target="#rows"
			class="btn btn-icon"
			aria-label="Precedente">
		<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
			<polyline points="15 18 9 12 15 6"></polyline>
		</svg>
	</button>
}

templ nextButton(data models.CollectionPageData) {
	<button hx-get={ paginationURL(data, data.Page+1) }
			hx-target="#rows"
			class="btn btn-icon"
			aria-label="Successiva">
		<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
			<polyline points="9 6 15 12 9 18"></polyline>
		</svg>
	</button>
}