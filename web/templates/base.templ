package templates

import "github.com/emiliopalmerini/quintaedizione.online/internal/adapters/web/models"

templ BaseLayout(data models.PageData) {
	@SiteLayout(data.Title, data.Description, "srd", nil) {
		if data.Collection != "" || data.DocTitle != "" {
			<nav class="breadcrumb mb-4" aria-label="Breadcrumb">
				<a href="/srd">SRD</a>
				if data.Collection != "" {
					<span class="breadcrumb-separator">/</span>
					<a href={ templ.URL("/srd/" + data.Collection) }>{ data.Collection }</a>
				}
				if data.DocTitle != "" {
					<span class="breadcrumb-separator">/</span>
					<span class="breadcrumb-current" title={ data.DocTitle }>{ data.DocTitle }</span>
				}
			</nav>
		}
		{ children... }
	}
}
