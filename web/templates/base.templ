package templates

import "github.com/emiliopalmerini/quintaedizione.online/internal/srd/web/models"
import "github.com/emiliopalmerini/quintaedizione.online/internal/srd/domain/collections"

templ BaseLayout(data models.PageData) {
	@SiteLayout(data.Title, data.Description, "srd", nil) {
		if data.Collection != "" || data.DocTitle != "" {
			<nav class="breadcrumb mb-4" aria-label="Breadcrumb">
				<a href="/srd">Compendio</a>
				if data.Collection != "" {
					<span class="breadcrumb-separator">/</span>
					if data.DocTitle != "" {
						<a href={ templ.URL("/srd/" + data.Collection) }>{ collections.GetTitle(data.Collection) }</a>
					} else {
						<span class="breadcrumb-current" aria-current="page">{ collections.GetTitle(data.Collection) }</span>
					}
				}
				if data.DocTitle != "" {
					<span class="breadcrumb-separator">/</span>
					<span class="breadcrumb-current" aria-current="page" title={ data.DocTitle }>{ data.DocTitle }</span>
				}
			</nav>
		}
		{ children... }
	}
}
