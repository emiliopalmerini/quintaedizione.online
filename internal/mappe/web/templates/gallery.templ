package templates

import (
	"strconv"
	"net/url"

	maps "github.com/emiliopalmerini/quintaedizione.online/internal/mappe/domain"
	siteTemplates "github.com/emiliopalmerini/quintaedizione.online/web/templates"
)

func isActiveTag(active []string, tag string) bool {
	for _, t := range active {
		if t == tag {
			return true
		}
	}
	return false
}

func loadMoreURL(data maps.GalleryData) string {
	v := url.Values{}
	v.Set("offset", strconv.Itoa(data.Offset+data.Limit))
	if data.Query != "" {
		v.Set("q", data.Query)
	}
	if len(data.ActiveTags) > 0 {
		for _, tag := range data.ActiveTags {
			v.Add("tag", tag)
		}
	}
	return "/mappe?" + v.Encode()
}

templ GalleryPage(data maps.GalleryData) {
	@siteTemplates.SiteLayout("Mappe", "Galleria di mappe per D&D 5e — cerca per nome, categoria o tag.", "mappe", nil) {
		<div class="page-header">
			<h1>Mappe</h1>
			<p class="page-header-subtitle">
				Mappe a uso commerciale di <a href="https://dysonlogos.blog" target="_blank" rel="noopener noreferrer">Dyson Logos</a>.
			</p>
		</div>

		<form id="mappe-filter-form"
			action="/mappe"
			method="get"
			role="search"
			hx-get="/mappe"
			hx-target="#mappe-grid"
			hx-trigger="submit, change from:input[name='tag']"
			hx-push-url="true"
			hx-swap="outerHTML"
		>
			<div class="mappe-search-controls">
				<label class="sr-only" for="mappe-search">Cerca mappe</label>
				<input
					type="search"
					name="q"
					id="mappe-search"
					placeholder="Cerca mappa..."
					class="field"
					autocomplete="off"
					value={ data.Query }
				/>
				<button type="submit" class="btn btn-primary">Cerca</button>
			</div>

			<details class="tag-picker">
				<summary>
					Filtra per tag
					if len(data.ActiveTags) > 0 {
						<span class="tag-picker-count">{ strconv.Itoa(len(data.ActiveTags)) }</span>
					}
				</summary>
				<fieldset class="tag-picker-options">
					<legend class="sr-only">Tag delle mappe</legend>
					for _, tag := range data.Tags {
						<label class="tag-picker-option">
							if isActiveTag(data.ActiveTags, tag) {
								<input type="checkbox" name="tag" value={ tag } checked/>
							} else {
								<input type="checkbox" name="tag" value={ tag }/>
						}
							<span>{ tag }</span>
						</label>
					}
				</fieldset>
			</details>
		</form>

		@GalleryGrid(data)
	}
}

templ GalleryGrid(data maps.GalleryData) {
	<div id="mappe-grid" class="mappe-grid">
		<div class="stats-banner mappe-grid-full">
			<span class="stats-banner-item">
				<strong>{ strconv.Itoa(data.Total) }</strong> mappe trovate
			</span>
		</div>
		if len(data.Mappe) == 0 {
			<div class="mappe-empty">
				<p>Nessuna mappa trovata.</p>
				<a href="/mappe" class="btn btn-secondary">Cancella filtri</a>
			</div>
		} else {
			for i, m := range data.Mappe {
				@mappeCard(m, i == 0 && data.Offset == 0)
			}
			if data.HasMore {
				@loadMoreButton(data)
			}
		}
	</div>
}

templ GalleryCards(data maps.GalleryData) {
	for _, m := range data.Mappe {
		@mappeCard(m, false)
	}
	if data.HasMore {
		@loadMoreButton(data)
	}
}

templ mappeCard(m maps.Mappa, eager bool) {
	<a href={ templ.URL("/mappe/" + m.Slug) } class="mappe-card">
		<div class="mappe-card-img">
			if eager {
				<img src={ "/static/img/mappe/thumbs/" + m.Immagine } alt="" decoding="async" fetchpriority="high"/>
			} else {
				<img src={ "/static/img/mappe/thumbs/" + m.Immagine } alt="" loading="lazy" decoding="async"/>
			}
		</div>
		<div class="mappe-card-body">
			<div class="mappe-card-title">{ m.Nome }</div>
			if len(m.Tag) > 0 {
				<div class="mappe-card-tags">
					for _, t := range m.Tag {
						<span class="result-badge">{ t }</span>
					}
				</div>
			}
		</div>
	</a>
}

templ loadMoreButton(data maps.GalleryData) {
	<div id="mappe-load-more" class="mappe-grid-full">
		<a href={ templ.URL(loadMoreURL(data)) }
			class="btn btn-secondary load-more-btn"
			hx-get={ loadMoreURL(data) }
			hx-target="#mappe-load-more"
			hx-swap="outerHTML"
		>
			Mostra altre mappe
		</a>
	</div>
}
