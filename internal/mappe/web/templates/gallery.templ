package templates

import (
	"strconv"

	"github.com/emiliopalmerini/quintaedizione.online/internal/domain/maps"
	siteTemplates "github.com/emiliopalmerini/quintaedizione.online/web/templates"
)

templ GalleryPage(data maps.GalleryData) {
	@siteTemplates.SiteLayout("Mappe", "Galleria di mappe per D&D 5e — cerca per nome, categoria o tag.", "mappe", nil) {
		<h1>Mappe</h1>
		<p class="text-secondary mb-6">Mappe a uso commerciale di <a href="https://dysonlogos.blog" target="_blank" rel="noopener noreferrer">Dyson Logos</a>. Cerca per nome, filtra per categoria o tag.</p>

		<form id="mappe-filter-form"
			hx-get="/mappe/gallery"
			hx-target="#mappe-grid"
			hx-trigger="keyup delay:200ms from:#mappe-search, change from:select, click from:.mappe-chip"
			hx-push-url="true"
			hx-swap="outerHTML"
		>
			<div class="mappe-search-bar mb-4">
				<input
					type="text"
					name="q"
					id="mappe-search"
					placeholder="Cerca mappa..."
					class="field flex-1"
					autocomplete="off"
					value={ data.Query }
				/>
			</div>

			<div class="mappe-filters mb-4">
				<div class="mappe-chip-group" role="radiogroup" aria-label="Filtra per categoria">
					<button
						type="submit"
						name="categoria"
						value=""
						class={ "mappe-chip", templ.KV("active", data.Categoria == "") }
					>
						Tutte
					</button>
					for _, cat := range data.Categorie {
						<button
							type="submit"
							name="categoria"
							value={ cat }
							class={ "mappe-chip", templ.KV("active", data.Categoria == cat) }
						>
							{ cat }
						</button>
					}
				</div>

				if len(data.Tags) > 0 {
					<div class="mappe-chip-group mt-2" role="group" aria-label="Filtra per tag">
						for _, tag := range data.Tags {
							<button
								type="submit"
								name="tag"
								value={ tagValue(data.Tag, tag) }
								class={ "mappe-chip mappe-chip-sm", templ.KV("active", data.Tag == tag) }
							>
								{ tag }
							</button>
						}
					</div>
				}
			</div>
		</form>

		<div class="mappe-results-count mb-4 text-secondary text-sm">
			{ strconv.Itoa(data.Total) } mappe trovate
		</div>

		@GalleryGrid(data)
	}
}

templ GalleryGrid(data maps.GalleryData) {
	<div id="mappe-grid" class="mappe-grid">
		if len(data.Mappe) == 0 {
			<div class="mappe-empty">
				<p>Nessuna mappa trovata.</p>
				<a href="/mappe" class="btn btn-primary">Cancella filtri</a>
			</div>
		} else {
			for _, m := range data.Mappe {
				<a href={ templ.URL("/mappe/" + m.Slug) } class="mappe-card">
					<div class="mappe-card-img">
						<img
							src={ "/static/img/mappe/" + m.Immagine }
							alt={ m.Nome }
							loading="lazy"
						/>
					</div>
					<div class="mappe-card-body">
						<div class="mappe-card-title">{ m.Nome }</div>
						<div class="mappe-card-meta">{ m.Categoria }</div>
						if len(m.Tag) > 0 {
							<div class="mappe-card-tags">
								for _, t := range m.Tag {
									<span class="mappe-tag">{ t }</span>
								}
							</div>
						}
					</div>
				</a>
			}
		}
	</div>
}

// tagValue returns empty string if the tag is already active (toggle off), otherwise the tag value.
func tagValue(current, tag string) string {
	if current == tag {
		return ""
	}
	return tag
}
