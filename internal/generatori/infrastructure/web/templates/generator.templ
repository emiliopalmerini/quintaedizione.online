package templates

import (
	"fmt"

	"github.com/emiliopalmerini/quintaedizione.online/internal/generatori/domain"
	shared "github.com/emiliopalmerini/quintaedizione.online/web/templates"
)

templ Generator(table domain.Table, prev *domain.Table, next *domain.Table, result *domain.RollResult) {
	@shared.SiteLayout(table.Name, table.Description, "generatori", nil) {
		<div class="generator-page">
			<nav class="breadcrumb" aria-label="Breadcrumb">
				<a href="/generatori">Generatori</a>
				<span class="breadcrumb-separator" aria-hidden="true">/</span>
				<span class="breadcrumb-current">{ table.Name }</span>
			</nav>

			<h1>{ table.Name }</h1>
			<p class="generator-description">{ table.Description }</p>
			if table.Source.Author != "" {
				<p class="generator-source">
					Fonte: <a href={ templ.SafeURL(table.Source.URL) } target="_blank" rel="noopener noreferrer">{ table.Source.Author }</a>
				</p>
			}

			if table.Static {
				if table.IsMultiColumn() {
					@multiColumnTable(table)
				} else {
					<ol class="generator-table-list">
						for _, item := range table.Items {
							<li>
								@itemContent(item)
							</li>
						}
					</ol>
				}
			} else {
				<div class="generator-roller">
					<form
						action={ templ.URL("/generatori/" + table.ID + "/roll") }
						method="post"
						hx-post={ "/generatori/" + table.ID + "/roll" }
						hx-target="#roll-result"
						hx-swap="innerHTML"
					>
						<button type="submit" class="btn btn-primary btn-large">Tira { table.Die }</button>
					</form>

					<div id="roll-result" class="roll-result" role="status" aria-live="polite" aria-atomic="true">
						if result != nil {
							@Result(*result)
						} else {
							<p class="roll-result-placeholder">Premi il pulsante per tirare</p>
						}
					</div>
				</div>

				<details class="generator-table-details">
					<summary>Mostra tutta la tabella ({ table.Die })</summary>
					if table.IsMultiColumn() {
						@multiColumnTable(table)
					} else {
						<ol class="generator-table-list">
							for _, item := range table.Items {
								<li>
									@itemContent(item)
								</li>
							}
						</ol>
					}
				</details>
			}

			<nav class="generator-nav" aria-label="Navigazione generatori">
				if prev != nil {
					<a href={ templ.SafeURL("/generatori/" + prev.ID) } class="generator-nav-link generator-nav-prev">
						<span class="generator-nav-direction">&larr; Precedente</span>
						<span class="generator-nav-title">{ prev.Name }</span>
					</a>
				} else {
					<span></span>
				}
				if next != nil {
					<a href={ templ.SafeURL("/generatori/" + next.ID) } class="generator-nav-link generator-nav-next">
						<span class="generator-nav-direction">Successivo &rarr;</span>
						<span class="generator-nav-title">{ next.Name }</span>
					</a>
				}
			</nav>
		</div>
	}
}

templ itemContent(item domain.Item) {
	if item.Link != "" {
		<a href={ templ.SafeURL(item.Link) }>{ item.Text }</a>
	} else {
		{ item.Text }
	}
}

templ multiColumnTable(table domain.Table) {
	<div class="generator-table-scroll" role="region" aria-label={ "Tabella completa: " + table.Name } tabindex="0">
		<table class="generator-full-table">
			<caption class="sr-only">{ table.Name }</caption>
			<thead>
				<tr>
					<th scope="col">Tiro</th>
					for _, col := range table.Columns {
						<th scope="col">{ col.Name }</th>
					}
				</tr>
			</thead>
			<tbody>
				for i := range maxColumnLength(table.Columns) {
					<tr>
						<th scope="row">{ fmt.Sprintf("%d", i+1) }</th>
						for _, col := range table.Columns {
							if i < len(col.Items) {
								<td>
									@itemContent(col.Items[i])
								</td>
							} else {
								<td>—</td>
							}
						}
					</tr>
				}
			</tbody>
		</table>
	</div>
}

func maxColumnLength(columns []domain.Column) int {
	maxLength := 0
	for _, column := range columns {
		if len(column.Items) > maxLength {
			maxLength = len(column.Items)
		}
	}
	return maxLength
}
