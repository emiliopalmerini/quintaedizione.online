package templates

import (
	"github.com/emiliopalmerini/quintaedizione.online/internal/generatori/domain"
	shared "github.com/emiliopalmerini/quintaedizione.online/web/templates"
)

templ Home(groups []domain.Group, query string) {
	@shared.SiteLayout("Generatori Casuali", "Generatori casuali per Dungeon Master — tabelle ispirate al Lazy GM di Sly Flourish.", "generatori", nil) {
		<div class="page-header page-header-map" style="--map-bg: url('/static/img/dyson-map-2.webp')">
			<h1>Generatori Casuali</h1>
			<p class="page-header-subtitle">Tabelle casuali per il Lazy DM. Tira i dadi e lasciati ispirare.</p>
		</div>

		<form
			hx-get="/generatori/"
			hx-target="#generatori-grid"
			hx-trigger="keyup delay:200ms from:#generatori-search"
			hx-push-url="true"
			hx-swap="outerHTML"
		>
			<div class="mb-4">
				<input
					type="text"
					name="q"
					id="generatori-search"
					placeholder="Cerca generatore..."
					class="field"
					autocomplete="off"
					value={ query }
				/>
			</div>
		</form>

		@GeneratoriGrid(groups, query)
	}
}

templ infoIcon() {
	<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		<circle cx="12" cy="12" r="10"></circle>
		<path d="M12 16v-4"></path>
		<path d="M12 8h.01"></path>
	</svg>
}

templ GeneratoriGrid(groups []domain.Group, query string) {
	<div id="generatori-grid">
		if len(groups) == 0 {
			<div class="mappe-empty">
				<p>Nessun generatore trovato.</p>
				<a href="/generatori/" class="btn btn-secondary">Cancella filtri</a>
			</div>
		} else {
			for _, group := range groups {
				<section class="collection-group">
					<div class="collection-group-header">
						<span class="collection-group-label">{ group.Label }</span>
						if group.Description != "" {
							<span class="collection-group-info" title={ group.Description }>
								@infoIcon()
							</span>
						}
					</div>
					<div class="generator-grid">
						for _, t := range group.Tables {
							<a href={ templ.SafeURL("/generatori/" + t.ID) } class="generator-card">
								<h2 class="generator-card-title">{ t.Name }</h2>
								<p class="generator-card-desc">{ t.Description }</p>
								if !t.Static {
									<span class="generator-card-die">{ t.Die }</span>
								}
							</a>
						}
					</div>
				</section>
			}
		}
	</div>
}
