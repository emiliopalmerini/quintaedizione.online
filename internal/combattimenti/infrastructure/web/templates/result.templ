package templates

import (
	"strconv"

	"github.com/emiliopalmerini/quintaedizione.online/internal/combattimenti/application/encounter"
	"github.com/emiliopalmerini/quintaedizione.online/internal/combattimenti/domain/monster"
)

// DifficultyTier represents one difficulty level with its XP budget.
type DifficultyTier struct {
	Label    string // Display label (e.g. "Bassa", "Moderata")
	Value    string // Form value (e.g. "Low", "Moderate")
	XP       int
	Selected bool
}

// ResultData holds all data needed to render the result panel.
type ResultData struct {
	Result *encounter.CalculateXPResponse
	Tiers  []DifficultyTier
	Cart   CartView
	Picker PickerData
}

// CartView is the priced cart snapshot rendered in the result panel.
type CartView struct {
	Entries       []monster.CartEntry
	Subtotal      int
	EffectiveCost int
	Remaining     int
	Multiplier    bool // true for 2014 (show effective row)
}

func xpPerCharacter(totalXP, partySize int) string {
	if partySize == 0 {
		return "0"
	}
	return strconv.Itoa(totalXP / partySize)
}

func tierPercentage(tierXP, maxXP int) string {
	if maxXP == 0 {
		return "0"
	}
	pct := (tierXP * 100) / maxXP
	if pct > 100 {
		pct = 100
	}
	return strconv.Itoa(pct)
}

templ Result(data ResultData) {
	<div class="result-card success">
		<!-- XP Budget -->
		<div class="result-budget">
			<span class="result-budget-label">Budget XP</span>
			<span class="result-budget-value">{ strconv.Itoa(data.Result.TotalXP) }</span>
			<span class="result-budget-per">{ xpPerCharacter(data.Result.TotalXP, data.Result.PartySize) } XP per personaggio</span>
		</div>

		<!-- Party Summary -->
		<div class="result-party-summary">
			<span class="result-party-tag">D&D { data.Result.Ruleset.String() }</span>
			<span class="result-party-tag">
				{ strconv.Itoa(data.Result.PartySize) }
				if data.Result.PartySize == 1 {
					personaggio
				} else {
					personaggi
				}
			</span>
			<span class="result-party-tag">
				Lv.
				for i, level := range data.Result.CharacterLevels {
					if i > 0 {
						<span>, </span>
					}
					{ strconv.Itoa(level) }
				}
			</span>
		</div>

		<!-- Difficulty Tiers -->
		if len(data.Tiers) > 0 {
			<div class="result-tiers">
				<h3 class="result-tiers-title">Soglie di Difficoltà</h3>
				for _, tier := range data.Tiers {
					<div class={ "result-tier", templ.KV("result-tier-active", tier.Selected) }>
						<div class="result-tier-header">
							<span class="result-tier-label">{ tier.Label }</span>
							<span class="result-tier-xp">{ strconv.Itoa(tier.XP) } XP</span>
						</div>
						<div class="result-tier-bar">
							<div class="result-tier-fill" style={ "width:" + tierPercentage(tier.XP, data.Tiers[len(data.Tiers)-1].XP) + "%" }></div>
						</div>
					</div>
				}
			</div>
		}

		@Cart(data.Cart)
	</div>

	<!-- Monster Picker (out-of-band swap: rendered into #monster-picker-slot) -->
	<div id="monster-picker-slot" hx-swap-oob="innerHTML">
		@MonsterPicker(data.Picker)
	</div>
}

templ Cart(view CartView) {
	<div class="result-cart">
		<h3 class="result-cart-title">Il tuo combattimento</h3>
		if len(view.Entries) == 0 {
			<p class="result-cart-empty">Aggiungi mostri dal pannello qui sotto per spenderli col budget.</p>
		} else {
			<ul class="result-cart-list">
				for i, entry := range view.Entries {
					<li class="result-cart-chip">
						<span class="result-cart-chip-name">{ entry.Name }</span>
						<span class="result-cart-chip-xp">{ strconv.Itoa(entry.UnitXP) } PE</span>
						<button
							type="button"
							class="result-cart-chip-remove"
							data-cart-index={ strconv.Itoa(i) }
							aria-label={ "Rimuovi " + entry.Name }
						>×</button>
					</li>
				}
			</ul>
			<dl class="result-cart-totals">
				<div>
					<dt>Costo base</dt>
					<dd>{ strconv.Itoa(view.Subtotal) } PE</dd>
				</div>
				if view.Multiplier {
					<div>
						<dt>Costo effettivo (×{ strconv.Itoa(len(view.Entries)) } mostri)</dt>
						<dd>{ strconv.Itoa(view.EffectiveCost) } PE</dd>
					</div>
				}
				<div class={ "result-cart-remaining", templ.KV("is-overspent", view.Remaining < 0) }>
					<dt>Residuo</dt>
					<dd>{ strconv.Itoa(view.Remaining) } PE</dd>
				</div>
			</dl>
		}
	</div>
}
