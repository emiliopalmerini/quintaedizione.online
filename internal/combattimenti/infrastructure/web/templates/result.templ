package templates

import (
	"strconv"
	"strings"

	"github.com/emiliopalmerini/quintaedizione.online/internal/combattimenti/application/encounter"
	"github.com/emiliopalmerini/quintaedizione.online/internal/combattimenti/domain/monster"
)

// DifficultyTier represents one difficulty level with its XP budget.
type DifficultyTier struct {
	Label    string // Display label (e.g. "Bassa", "Moderata")
	Value    string // Form value (e.g. "Low", "Moderate")
	XP       int
	Selected bool
}

// ResultData holds all data needed to render the result panel.
type ResultData struct {
	Result       *encounter.CalculateXPResponse
	Tiers        []DifficultyTier
	Cart         CartView
	Picker       PickerData
	InferredTier encounter.InferredTier
	HasCartItems bool
	IsOverspent  bool
}

// CartView is the priced cart snapshot rendered in the result panel.
type CartView struct {
	Entries       []monster.CartEntry
	Subtotal      int
	EffectiveCost int
	Budget        int
	Remaining     int
	Multiplier    bool // true for 2014 (show effective row)
}

func selectedTier(tiers []DifficultyTier) DifficultyTier {
	for _, tier := range tiers {
		if tier.Selected {
			return tier
		}
	}
	return DifficultyTier{}
}

func positiveXP(value int) int {
	if value < 0 {
		return -value
	}
	return value
}

func partyDescription(levels []int) string {
	if len(levels) == 0 {
		return "0 PG"
	}
	allEqual := true
	for _, level := range levels[1:] {
		if level != levels[0] {
			allEqual = false
			break
		}
	}
	if allEqual {
		return strconv.Itoa(len(levels)) + " PG · livello " + strconv.Itoa(levels[0])
	}
	parts := make([]string, len(levels))
	for i, level := range levels {
		parts[i] = strconv.Itoa(level)
	}
	return strconv.Itoa(len(levels)) + " PG · livelli " + strings.Join(parts, ", ")
}

func targetDelta(remaining int, target DifficultyTier) string {
	if remaining < 0 {
		return strconv.Itoa(positiveXP(remaining)) + " PE oltre il target " + target.Label
	}
	if remaining == 0 {
		return "Target " + target.Label + " raggiunto"
	}
	return strconv.Itoa(remaining) + " PE disponibili sul target " + target.Label
}

func tierPercentage(tierXP, maxXP int) string {
	if maxXP == 0 {
		return "0"
	}
	pct := (tierXP * 100) / maxXP
	if pct > 100 {
		pct = 100
	}
	return strconv.Itoa(pct)
}

templ Result(data ResultData) {
	<details class="encounter-result-shell">
		<summary class="encounter-mobile-summary">
			<span>
				<strong>{ data.InferredTier.Label }</strong>
				if data.HasCartItems {
					<span>{ strconv.Itoa(totalMonsters(data.Cart.Entries)) } mostri</span>
				} else {
					<span>Carrello vuoto</span>
				}
			</span>
			<span class="encounter-mobile-summary-xp">{ strconv.Itoa(data.Cart.EffectiveCost) } / { strconv.Itoa(data.Cart.Budget) } PE</span>
		</summary>
	<div class={ "result-card", templ.KV("is-overspent", data.IsOverspent) }>
		<div class="result-party-summary">
			<span class="result-party-context">D&D { data.Result.Ruleset.String() } · { partyDescription(data.Result.CharacterLevels) }</span>
			<button
				type="button"
				id="copy-link-btn"
				class="btn btn-secondary result-copy-link"
				data-copy-default="Copia link"
				data-copy-success="Copiato!"
				aria-label="Copia il link condivisibile di questo incontro"
			>
				Copia link
			</button>
		</div>
		if data.HasCartItems {
			<div class="result-overview" role="status" aria-live="polite" aria-atomic="true">
				<div class="result-overview-difficulty">
					<span>Difficoltà attuale</span>
					<strong>{ data.InferredTier.Label }</strong>
				</div>
				<strong class="result-overview-xp">{ strconv.Itoa(data.Cart.EffectiveCost) } PE</strong>
				<span class={ "result-overview-delta", templ.KV("is-overspent", data.IsOverspent) }>{ targetDelta(data.Cart.Remaining, selectedTier(data.Tiers)) }</span>
			</div>
		}

		<!-- Difficulty Tiers -->
		if len(data.Tiers) > 0 {
			<div class="result-tiers">
				<h3 class="result-tiers-title">Soglie di Difficoltà</h3>
				for _, tier := range data.Tiers {
					<div class={ "result-tier", templ.KV("result-tier-target", tier.Selected) }>
						<div class="result-tier-header">
							<span class="result-tier-label">{ tier.Label }</span>
							<span class="result-tier-xp">{ strconv.Itoa(tier.XP) } PE</span>
						</div>
						<div class="result-tier-bar" aria-hidden="true">
							<div class="result-tier-fill" style={ "width:" + tierPercentage(tier.XP, data.Tiers[len(data.Tiers)-1].XP) + "%" }></div>
						</div>
					</div>
				}
			</div>
		}

		@Cart(data.Cart)
	</div>
	</details>
}

// totalMonsters sums per-entry quantities for the 2014 multiplier label.
func totalMonsters(entries []monster.CartEntry) int {
	total := 0
	for _, e := range entries {
		total += e.Quantity
	}
	return total
}

templ Cart(view CartView) {
	<div class="result-cart">
		<div class="result-cart-header">
			<h3 class="result-cart-title">Mostri · { strconv.Itoa(totalMonsters(view.Entries)) }</h3>
		</div>
		if len(view.Entries) == 0 {
			<p class="result-cart-empty">Aggiungi mostri dal pannello centrale.</p>
		} else {
			<ul class="result-cart-list">
				for _, entry := range view.Entries {
					<li class="result-cart-chip">
						<span class="result-cart-chip-qty">{ strconv.Itoa(entry.Quantity) }×</span>
						<a class="result-cart-chip-name" href={ srdLink(monster.Monster{ID: entry.ID, Source: entry.Source}) }>{ entry.Name }</a>
						<button
							type="submit"
							form="encounter-form"
							name="cart_action"
							value={ "decrement:" + entry.ID + "@" + entry.Source }
							class="result-cart-chip-step"
							data-cart-id={ entry.ID }
							data-cart-source={ entry.Source }
							data-cart-delta="-1"
							aria-label={ "Diminuisci " + entry.Name }
						>−</button>
						<button
							type="submit"
							form="encounter-form"
							name="cart_action"
							value={ "increment:" + entry.ID + "@" + entry.Source }
							class="result-cart-chip-step"
							data-cart-id={ entry.ID }
							data-cart-source={ entry.Source }
							data-cart-delta="1"
							aria-label={ "Aumenta " + entry.Name }
						>+</button>
						<button
							type="submit"
							form="encounter-form"
							name="cart_action"
							value={ "remove:" + entry.ID + "@" + entry.Source }
							class="result-cart-chip-remove"
							data-cart-id={ entry.ID }
							data-cart-source={ entry.Source }
							aria-label={ "Rimuovi " + entry.Name }
						>×</button>
					</li>
				}
			</ul>
			if view.Multiplier {
				<dl class="result-cart-totals">
					<div><dt>PE base</dt><dd>{ strconv.Itoa(view.Subtotal) }</dd></div>
					<div><dt>PE effettivi</dt><dd>{ strconv.Itoa(view.EffectiveCost) }</dd></div>
				</dl>
			}
		}
	</div>
}
