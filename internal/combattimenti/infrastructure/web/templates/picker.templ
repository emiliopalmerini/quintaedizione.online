package templates

import (
	"net/url"
	"strconv"

	"github.com/emiliopalmerini/quintaedizione.online/internal/combattimenti/domain/monster"
)

// PickerData holds the rendering state for the monster-picker partial.
type PickerData struct {
	Source       string // edition short name
	Query        string // current search needle
	MinCR        float64
	MaxCR        float64
	Type         string   // selected creature type filter (empty = any)
	Types        []string // dropdown options sourced from Reader.Facets
	Monsters     []monster.Monster
	TotalMatched int
	Limit        int
	Error        string
}

func (d PickerData) currentLimit() int {
	if d.Limit < 20 {
		return 20
	}
	return d.Limit
}

func (d PickerData) loadMoreURL() string {
	values := url.Values{}
	values.Set("source", d.Source)
	values.Set("limit", strconv.Itoa(d.currentLimit()+20))
	if d.Query != "" {
		values.Set("q", d.Query)
	}
	if d.MinCR > 0 {
		values.Set("min_cr", formatCR(d.MinCR))
	}
	if d.MaxCR > 0 {
		values.Set("max_cr", formatCR(d.MaxCR))
	}
	if d.Type != "" {
		values.Set("type", d.Type)
	}
	return "/combattimenti/monsters?" + values.Encode()
}

// activeFilterCount counts non-default picker filters for the disclosure hint.
func (d PickerData) activeFilterCount() int {
	n := 0
	if d.MinCR > 0 {
		n++
	}
	if d.MaxCR > 0 {
		n++
	}
	if d.Type != "" {
		n++
	}
	return n
}

// hasAnyFilter is true when the picker has any active filter or a search
// query — used to decide whether to show the reset button.
func (d PickerData) hasAnyFilter() bool {
	return d.Query != "" || d.activeFilterCount() > 0
}

// formatCR renders a float CR for input value reuse; 0 stays empty so the
// placeholder shows through.
func formatCR(v float64) string {
	if v <= 0 {
		return ""
	}
	return strconv.FormatFloat(v, 'f', -1, 64)
}

// srdLink builds the SRD viewer URL for a monster so the picker name links
// out to the full stat block in a new tab.
func srdLink(m monster.Monster) string {
	return "/srd/mostri/" + m.Source + "/" + m.ID
}

templ MonsterPicker(data PickerData) {
	<div id="monster-picker" class="monster-picker">
		<form
			class="monster-picker-controls"
			action="/combattimenti"
			method="get"
			hx-get="/combattimenti/monsters"
			hx-target="#monster-picker"
			hx-swap="outerHTML"
			hx-trigger="input changed delay:200ms from:find input[type='search'], change from:find input[type='number'], change from:find select"
		>
			<input type="hidden" name="source" value={ data.Source }/>
			<input type="hidden" name="limit" value={ strconv.Itoa(data.currentLimit()) }/>
			if data.activeFilterCount() > 0 {
				<details class="monster-picker-filters" open>
					<summary>
						Filtri avanzati
						<span class="monster-picker-filters-badge">{ strconv.Itoa(data.activeFilterCount()) } filtri attivi</span>
					</summary>
					@pickerFiltersBody(data)
				</details>
			} else {
				<details class="monster-picker-filters">
					<summary>Filtri avanzati</summary>
					@pickerFiltersBody(data)
				</details>
			}
			<div class="monster-picker-search">
				<input
					id="monster-picker-search-input"
					type="search"
					name="q"
					value={ data.Query }
					placeholder="Cerca un mostro…"
					autocomplete="off"
					aria-label="Cerca un mostro per nome"
					hx-preserve="true"
				/>
				<button type="submit" class="btn btn-primary">Cerca</button>
			</div>
			if data.hasAnyFilter() {
				<a
					href="/combattimenti"
					class="btn btn-secondary monster-picker-reset"
					title="Cancella ricerca e filtri"
					aria-label="Cancella ricerca e filtri"
				>
					× Reset
				</a>
			}
			<div class="htmx-indicator monster-picker-loading" role="status"><span class="spinner" aria-hidden="true"></span> Ricerca in corso...</div>
		</form>
		<div id="monster-picker-results" aria-live="polite" aria-atomic="false">
			if data.Error != "" {
				<p class="monster-picker-error" role="alert">{ data.Error }</p>
			} else if len(data.Monsters) == 0 {
				<p class="monster-picker-empty">Nessun mostro trovato per questa ricerca.</p>
			} else {
			<p class="monster-picker-count">{ strconv.Itoa(len(data.Monsters)) } di { strconv.Itoa(data.TotalMatched) } mostri</p>
			<ul class="monster-picker-list">
				for _, m := range data.Monsters {
					<li class="monster-picker-row">
						<div class="monster-picker-row-summary">
								<a class="monster-picker-row-name" href={ srdLink(m) }>{ m.Name }</a>
								<span class="monster-picker-row-inline">
									<span>GS { m.CR } <span class="monster-picker-row-xp">({ strconv.Itoa(m.XP) } PE)</span></span>
									if m.Type != "" {
										<span class="monster-picker-row-type">{ m.Type }</span>
									}
									if m.HP != "" {
										<span><strong>PF</strong> { m.HP }</span>
									}
									if m.AC != "" {
										<span><strong>CA</strong> { m.AC }</span>
									}
								</span>
						</div>
						<button
							type="submit"
							form="encounter-form"
							name="cart_action"
							value={ "add:" + m.ID + "@" + m.Source }
							class="btn btn-secondary monster-picker-row-add"
							data-monster-id={ m.ID }
							data-monster-source={ m.Source }
							data-monster-name={ m.Name }
							data-monster-xp={ strconv.Itoa(m.XP) }
							data-monster-cr={ m.CR }
							aria-label={ "Aggiungi " + m.Name + " al combattimento" }
						>
							+ Aggiungi
						</button>
					</li>
				}
			</ul>
			if len(data.Monsters) < data.TotalMatched {
				<a
					href={ templ.SafeURL(data.loadMoreURL()) }
					class="btn btn-secondary monster-picker-more"
					hx-get={ data.loadMoreURL() }
					hx-target="#monster-picker"
					hx-swap="outerHTML"
				>Carica altri</a>
			}
		}
		</div>
	</div>
}

templ pickerFiltersBody(data PickerData) {
	<div class="monster-picker-filters-row">
		<label class="monster-picker-filter">
			<span>GS minimo</span>
			<input
				type="number"
				name="min_cr"
				step="0.125"
				min="0"
				max="30"
				placeholder="0"
				value={ formatCR(data.MinCR) }
				inputmode="decimal"
			/>
		</label>
		<label class="monster-picker-filter">
			<span>GS massimo</span>
			<input
				type="number"
				name="max_cr"
				step="0.125"
				min="0"
				max="30"
				placeholder="0"
				value={ formatCR(data.MaxCR) }
				inputmode="decimal"
			/>
		</label>
		<label class="monster-picker-filter">
			<span>Tipo</span>
			<select name="type">
				<option value="">Qualsiasi</option>
				for _, t := range data.Types {
					if t == data.Type {
						<option value={ t } selected>{ t }</option>
					} else {
						<option value={ t }>{ t }</option>
					}
				}
			</select>
		</label>
	</div>
}
