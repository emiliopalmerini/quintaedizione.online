package templates

import (
	"strconv"

	shared "github.com/emiliopalmerini/quintaedizione.online/web/templates"
)

// EditionOption represents a source available for the encounter calculator.
type EditionOption struct {
	SourceID  string // e.g. "srd-5.5e"
	Name      string // e.g. "SRD 5.2.1 (2024)"
	ShortName string // e.g. "5.5e"
	Ruleset   string // e.g. "2024"
	IsDefault bool
}

// CartSeed is one entry pre-populated from the URL share-link. The picker
// resolves these on first calculate; the home template just stamps the
// hidden inputs the existing JS / handler already understand.
type CartSeed struct {
	ID       string
	Source   string
	Quantity int
}

// HomeData is the view model for the encounter home page.
//
// All fields except Editions are optional; sensible defaults are applied by
// the handler before passing this in. Result is usually set by server-side
// prerendering so first paint matches the calculator's default state.
type HomeData struct {
	Editions []EditionOption

	// Hydrated form state.
	Ruleset string // "2024" | "2014"
	Difficulty string
	Party   []int  // character levels (replaces same/different inputs)

	// Cart pre-populated from the URL share link. These render as the same
	// hidden <input name="monsters[]"> elements the JS layer manages so the
	// next calculate POST naturally picks them up.
	Cart []CartSeed

	// SourceShort matches the active ruleset's edition (e.g. "5.5e"). Used to
	// pre-fill the source_short hidden input so the first server calculate
	// can price the seeded cart without waiting for JS hydration.
	SourceShort string

	// Prerendered result. When non-nil, the result rail ships with the
	// computed tier bars + cart instead of the placeholder. Saves a round-trip
	// when the user lands on a shared link.
	Result *ResultData

	// Initial picker rendered server-side so the central column is populated
	// on first paint. Always set by the handler.
	Picker PickerData
}

type targetOption struct {
	Value string
	Label string
}

func (d HomeData) targetOptions() []targetOption {
	if d.Ruleset == "2014" {
		return []targetOption{{"Facile", "Facile"}, {"Media", "Media"}, {"Difficile", "Difficile"}, {"Letale", "Letale"}}
	}
	return []targetOption{{"Low", "Bassa"}, {"Moderate", "Moderata"}, {"High", "Alta"}}
}

func (d HomeData) targetDifficulty() string {
	if d.Difficulty != "" {
		return d.Difficulty
	}
	if d.Ruleset == "2014" {
		return "Media"
	}
	return "Moderate"
}

// is2024 picks the ruleset for default-rendering decisions.
func (d HomeData) is2024() bool {
	return d.Ruleset != "2014"
}

// editionChecked says whether a given edition radio should be pre-checked.
// Mirrors NewHomeData's defaulting: when no Ruleset is set, IsDefault wins.
func (d HomeData) editionChecked(ed EditionOption) bool {
	if d.Ruleset == "" {
		return ed.IsDefault
	}
	return ed.Ruleset == d.Ruleset
}

// partyLevels returns the levels to seed the same-mode input. The first
// element seeds the level field; the count is len(Party). When Party is
// empty we fall back to the original 4× level-3 baseline.
func (d HomeData) partyLevels() []int {
	if len(d.Party) == 0 {
		return []int{3, 3, 3, 3}
	}
	return d.Party
}

// partyLevel picks the dominant level to seed the same-mode level input
// (first element when the party has any entries).
func (d HomeData) partyLevel() int {
	levels := d.partyLevels()
	return levels[0]
}

// partyCount drives the same-mode count input.
func (d HomeData) partyCount() int {
	return len(d.partyLevels())
}

// isSameMode is true when every party level matches partyLevel(). The form
// shows the "same" panel when so; otherwise we open in "different" mode and
// seed the per-character inputs.
func (d HomeData) isSameMode() bool {
	levels := d.partyLevels()
	if len(levels) <= 1 {
		return true
	}
	first := levels[0]
	for _, l := range levels[1:] {
		if l != first {
			return false
		}
	}
	return true
}

templ Home(data HomeData) {
	@shared.SiteLayout("Combattimenti", "Costruttore di incontri D&D 5e per Dungeon Master: scegli edizione e party, aggiungi mostri al carrello e leggi in tempo reale la difficoltà inferita dai PE. Supporta regole 2014 e 2024.", "combattimenti", shared.EncountersScript()) {
		<div class="encounter-fullbleed">
			<header class="encounter-page-header">
				<p class="encounter-page-kicker">Strumenti per il DM</p>
				<h1>Costruttore di combattimenti</h1>
				<p>Configura il party, scegli la difficoltà obiettivo e aggiungi mostri per vedere subito il costo dell'incontro.</p>
			</header>
			<div class="encounter-builder">
			<aside class="encounter-builder-party">
				<form
					id="encounter-form"
					action="/combattimenti"
					method="post"
					hx-post="/combattimenti/calculate"
					hx-target="#result-container"
					hx-swap="innerHTML"
					hx-trigger="calculate"
					hx-indicator="#result-loading"
				>
					<div class="form-section">
						<h2 class="form-section-title">Edizione</h2>
						<div class="segmented-control" role="radiogroup" aria-label="Edizione delle regole">
							for _, ed := range data.Editions {
								<label class="segmented-control-option">
									if data.editionChecked(ed) {
										<input type="radio" name="ruleset" value={ ed.Ruleset } data-source={ ed.SourceID } data-source-short={ ed.ShortName } checked/>
									} else {
										<input type="radio" name="ruleset" value={ ed.Ruleset } data-source={ ed.SourceID } data-source-short={ ed.ShortName }/>
									}
									<span>{ ed.ShortName }</span>
								</label>
							}
						</div>
						<input type="hidden" name="source_short" id="source-short" value={ data.SourceShort }/>
					</div>
					<div class="form-section encounter-target-field">
						<label for="encounter-difficulty" class="form-section-title">Difficoltà obiettivo</label>
						<select id="encounter-difficulty" name="difficulty" data-ruleset={ data.Ruleset }>
							for _, option := range data.targetOptions() {
								if option.Value == data.targetDifficulty() {
									<option value={ option.Value } selected>{ option.Label }</option>
								} else {
									<option value={ option.Value }>{ option.Label }</option>
								}
							}
						</select>
					</div>
					<div class="form-section">
						<h2 class="form-section-title">Party</h2>
						<div class="segmented-control" role="radiogroup" aria-label="Modalità composizione party">
							<label class="segmented-control-option">
								if data.isSameMode() {
									<input type="radio" name="party_mode" value="same" checked/>
								} else {
									<input type="radio" name="party_mode" value="same"/>
								}
								<span>Stessi livelli</span>
							</label>
							<label class="segmented-control-option">
								if !data.isSameMode() {
									<input type="radio" name="party_mode" value="different" checked/>
								} else {
									<input type="radio" name="party_mode" value="different"/>
								}
								<span>Livelli diversi</span>
							</label>
						</div>
					</div>
					<div
						id="party-same-panel"
						class={ "form-section", templ.KV("hidden", !data.isSameMode()) }
					>
						<div class="form-grid-2col">
							<div class="form-field-group">
								<label for="party-level" class="form-label">Livello</label>
								<div class="stepper" data-min="1" data-max="20">
									<button type="button" class="stepper-btn stepper-decrement" aria-label="Diminuisci livello">−</button>
									<input
										type="number"
										id="party-level"
										name="level"
										value={ strconv.Itoa(data.partyLevel()) }
										min="1"
										max="20"
										class="stepper-input"
										required
									/>
									<button type="button" class="stepper-btn stepper-increment" aria-label="Aumenta livello">+</button>
								</div>
							</div>
							<div class="form-field-group">
								<label for="party-count" class="form-label">Personaggi</label>
								<div class="stepper" data-min="1" data-max="8">
									<button type="button" class="stepper-btn stepper-decrement" aria-label="Diminuisci personaggi">−</button>
									<input
										type="number"
										id="party-count"
										name="count"
										value={ strconv.Itoa(data.partyCount()) }
										min="1"
										max="8"
										class="stepper-input"
										required
									/>
									<button type="button" class="stepper-btn stepper-increment" aria-label="Aumenta personaggi">+</button>
								</div>
							</div>
						</div>
					</div>
					<div
						id="party-different-panel"
						class={ "form-section", templ.KV("hidden", data.isSameMode()) }
					>
						<div id="character-levels-container" class="character-levels-list">
							for i, level := range data.partyLevels() {
								<div class="character-input-group">
									<label for={ "character-level-" + strconv.Itoa(i + 1) }>PG { strconv.Itoa(i + 1) }</label>
									<input id={ "character-level-" + strconv.Itoa(i + 1) } type="number" name="character_levels" value={ strconv.Itoa(level) } min="1" max="20" required/>
								</div>
							}
						</div>
						<div class="form-actions-inline">
							<button type="button" id="add-character" class="btn btn-secondary">+ PG</button>
							<button type="button" id="remove-character" class="btn btn-secondary">− PG</button>
						</div>
					</div>
					<div id="cart-inputs" class="sr-only" aria-hidden="true">
						for _, entry := range data.Cart {
							<input type="hidden" name="monsters[]" value={ entry.ID + "@" + entry.Source + ":" + strconv.Itoa(entry.Quantity) }/>
						}
					</div>
					<div class="form-submit">
						<button type="submit" class="btn btn-primary btn-large">Aggiorna</button>
					</div>
				</form>
			</aside>
			<section class="encounter-builder-picker">
				<div id="monster-picker-slot">
					@MonsterPicker(data.Picker)
				</div>
			</section>
			<aside class="encounter-builder-result">
				<div id="result-loading" class="htmx-indicator encounter-result-loading" role="status">
					<span class="spinner" aria-hidden="true"></span>
					<span>Aggiornamento in corso...</span>
				</div>
				<div id="result-container">
					if data.Result != nil {
						@Result(*data.Result)
					} else {
						<div class="result-placeholder">
							<h3>Carrello vuoto</h3>
							<p>Aggiungi mostri dal pannello centrale.</p>
						</div>
					}
				</div>
			</aside>
			</div>
		</div>
	}
}
